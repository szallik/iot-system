# Ustawienia systemu. install.sh kopiuje ten plik do .env bez zmian.
# Środowisko laboratoryjne: broker MQTT bez haseł (dostęp anonimowy).

# --- MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Koordynator ZigBee NOUS E16 (Silicon Labs CP2102N) ---
# Ścieżka by-id nie zmienia się po przełożeniu wtyczki USB.
# Jeśli nie istnieje: ls -l /dev/serial/by-id/  (awaryjnie /dev/ttyUSB0)
ZIGBEE_SERIAL_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_7a711ea8c8d8f011b989f026c6dc3c96-if00-port0

# --- Backend ---
JWT_SECRET_KEY=123
DATABASE_URL=sqlite:///./data/iot_system.db
FRONTEND_DIST_PATH=../frontend/dist

# --- Wersja Zigbee2MQTT (ta sama co przed awarią) ---
Z2M_VERSION=2.14.2
