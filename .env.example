# Skopiuj do .env (cp .env.example .env) i ustaw własne hasła.
# Plik .env nie trafia do repozytorium.

# --- MQTT: konto backendu ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=zmien-haslo-backend

# --- MQTT: konto Zigbee2MQTT ---
Z2M_MQTT_USER=zigbee2mqtt
Z2M_MQTT_PASSWORD=zmien-haslo-z2m

# --- MQTT: konto do ręcznych testów (mosquitto_sub / mosquitto_pub) ---
MQTT_TEST_USER=tester
MQTT_TEST_PASSWORD=zmien-haslo-tester

# --- Koordynator ZigBee NOUS E16 (Silicon Labs CP2102N) ---
# Ścieżka by-id nie zmienia się po przełożeniu wtyczki USB.
# Jeśli nie istnieje: ls -l /dev/serial/by-id/  (awaryjnie /dev/ttyUSB0)
ZIGBEE_SERIAL_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_7a711ea8c8d8f011b989f026c6dc3c96-if00-port0

# --- Backend ---
# Wygeneruj: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=zmien-na-losowy-ciag
DATABASE_URL=sqlite:///./data/iot_system.db
FRONTEND_DIST_PATH=../frontend/dist

# --- Wersja Zigbee2MQTT (ta sama co przed awarią) ---
Z2M_VERSION=2.14.2
